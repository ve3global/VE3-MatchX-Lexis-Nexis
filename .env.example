DATABASE_URL="postgresql://postgres:postgres@localhost:5434/ln_replica?schema=public"
PORT=3000

# Shared secret required in the X-LN-Replica-Provision-Key header to call
# POST /clients (mints a new tenant's client_id/client_secret on demand).
# Leave unset to disable that endpoint entirely (it fails closed).
CLIENT_PROVISION_KEY=

# Real rate limiter (src/middleware/rateLimiter.ts). Requests per second per
# client; unset or invalid falls back to 10.
RATE_LIMIT_PER_SECOND=10

# limiter = real rate limiter applies (the default; unset or invalid falls
# back to this). run = real limiter bypassed entirely, so the only 429s are
# the ones simulation runs fabricate (X-LN-Replica-Run-Id).
THROTTLE_MODE=limiter
