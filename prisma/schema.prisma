generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id               String        @id @default(uuid())
  clientId         String        @unique @map("client_id")
  clientSecretHash String        @map("client_secret_hash")
  name             String
  createdAt        DateTime      @default(now()) @map("created_at")
  accessTokens     AccessToken[]
  reportTypes      ReportType[]
  scorecards       Scorecard[]
  reports          Report[]
  notifications    Notification[]
  webhooks         Webhook[]
  userProfile      UserProfile?
  company          Company?
  userOptions      UserOptions?
  activityLogs     ActivityLog[]

  @@map("clients")
}

model AccessToken {
  id        String    @id @default(uuid())
  token     String    @unique
  clientId  String    @map("client_id")
  client    Client    @relation(fields: [clientId], references: [id])
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("access_tokens")
}

// EPIC-1 opened this model with a foundation subset; EPIC-5 owns it in
// earnest and adds the remaining fields here (age_min/max,
// reference_required, is_default, category, status extension).
enum ReportTypeStatus {
  ACTIVE
  INACTIVE
}

model ReportType {
  id                String           @id @default(uuid())
  clientId          String           @map("client_id")
  client            Client           @relation(fields: [clientId], references: [id])
  name              String
  description       String?
  scorecardId       String?          @map("scorecard_id")
  scorecard         Scorecard?       @relation(fields: [scorecardId], references: [id])
  ageMin            Int?             @map("age_min")
  ageMax            Int?             @map("age_max")
  referenceRequired Boolean          @default(false) @map("reference_required")
  isDefault         Boolean          @default(false) @map("is_default")
  category          String?
  primaryActions    String[]         @map("primary_actions")
  secondaryActions  String[]         @map("secondary_actions")
  // Replica-only extension (see constitution.md) — no such field on the
  // doc's report-type response; DELETE still returns the doc's own 204.
  status            ReportTypeStatus @default(ACTIVE)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  reports           Report[]

  @@unique([clientId, name])
  @@map("report_types")
}

// EPIC-1 opened this model with a foundation subset; EPIC-6 owns it in
// earnest and adds the status/version extension here.
enum ScorecardStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model Scorecard {
  id            String          @id @default(uuid())
  clientId      String          @map("client_id")
  client        Client          @relation(fields: [clientId], references: [id])
  name          String
  passThreshold Int?            @map("pass_threshold")
  failThreshold Int?            @map("fail_threshold")
  groups        Json
  // Replica-only extension (see constitution.md) — no such field on the
  // doc's scorecard response.
  status        ScorecardStatus @default(DRAFT)
  version       Int             @default(1)
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  reportTypes   ReportType[]
  reports       Report[]

  @@unique([clientId, name])
  @@map("scorecards")
}

// EPIC-4: Reports Core.
enum ReportStatus {
  STARTED
  PENDING
  COMPLETE
}

model Report {
  id               String               @id @default(uuid())
  clientId         String               @map("client_id")
  client           Client               @relation(fields: [clientId], references: [id])
  reportTypeId     String?              @map("report_type_id")
  reportType       ReportType?          @relation(fields: [reportTypeId], references: [id], onDelete: SetNull)
  // Copied from reportType.scorecardId at creation time (if any) so a
  // report's assessment stays pinned to what was configured when it was
  // created, even if the report type's own scorecard changes later.
  scorecardId      String?              @map("scorecard_id")
  scorecard        Scorecard?           @relation(fields: [scorecardId], references: [id], onDelete: SetNull)
  forename         String?
  middlename       String?
  surname          String?
  dob              DateTime?
  address          Json?
  reference        String?
  enduserAgreement Boolean              @default(false) @map("enduser_agreement")
  test             Boolean              @default(false)
  status           ReportStatus         @default(STARTED)
  deletedAt        DateTime?            @map("deleted_at")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  actionResults    ReportActionResult[]
  auditLogs        ReportAuditLog[]
  remoteCheck      RemoteCheckTransaction?

  @@map("reports")
}

model ReportActionResult {
  id             String   @id @default(uuid())
  reportId       String   @map("report_id")
  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actionName     String   @map("action_name")
  requestPayload Json     @map("request_payload")
  resultPayload  Json     @map("result_payload")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([reportId, actionName])
  @@map("report_action_results")
}

model ReportAuditLog {
  id        String   @id @default(uuid())
  reportId  String   @map("report_id")
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  eventType String   @map("event_type")
  message   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("report_audit_logs")
}

// EPIC-9 (phase 2).
model Notification {
  id        String   @id @default(uuid())
  clientId  String   @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notifications")
}

// EPIC-10 (phase 2).
enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

model Webhook {
  id         String            @id @default(uuid())
  clientId   String            @map("client_id")
  client     Client            @relation(fields: [clientId], references: [id])
  url        String
  // Plaintext, not hashed — must be recoverable to sign each delivery's
  // HMAC (see spec.md's "Resolved conflicts"). Acceptable for a local
  // dev/test replica; not a production secrets-storage pattern.
  secret     String
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id        String                @id @default(uuid())
  webhookId String                @map("webhook_id")
  webhook   Webhook               @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  status    WebhookDeliveryStatus @default(PENDING)
  payload   Json
  signature String
  createdAt DateTime              @default(now()) @map("created_at")
  updatedAt DateTime              @updatedAt @map("updated_at")

  @@map("webhook_deliveries")
}

// EPIC-12 (phase 2) — supersedes EPIC-7c's synchronous remote-check design.
enum RemoteCheckStatus {
  IN_PROGRESS
  CANCELLED
  COMPLETED
}

model RemoteCheckTransaction {
  id        String            @id @default(uuid())
  reportId  String            @unique @map("report_id")
  report    Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status    RemoteCheckStatus @default(IN_PROGRESS)
  result    String?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("remote_check_transactions")
}

// EPIC-11 (phase 2) — thinnest-evidence epic of both phases; see
// planning/specs/epic-11-users-module/spec.md for per-field evidence
// (solid for UserProfile/ActivityLog, thinner for UserOptions, a near-
// total guess for Company).
model UserProfile {
  id          String   @id @default(uuid())
  clientId    String   @unique @map("client_id")
  client      Client   @relation(fields: [clientId], references: [id])
  username    String?  @unique
  gender      String?
  telephone   String?
  extension   String?
  mobile      String?
  webdevEmail String?  @map("webdev_email")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("user_profiles")
}

model Company {
  id        String   @id @default(uuid())
  clientId  String   @unique @map("client_id")
  client    Client   @relation(fields: [clientId], references: [id])
  name      String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("companies")
}

model UserOptions {
  id       String  @id @default(uuid())
  clientId String  @unique @map("client_id")
  client   Client  @relation(fields: [clientId], references: [id])
  // Action-enablement toggles — additive, not enforced (see spec.md's
  // "Out of scope").
  bankAccountValidation    Boolean @default(true) @map("bank_account_validation")
  drivingLicenceValidation Boolean @default(true) @map("driving_licence_validation")
  niNumberValidation       Boolean @default(true) @map("ni_number_validation")
  passportValidation       Boolean @default(true) @map("passport_validation")
  addressInsights          Boolean @default(true) @map("address_insights")
  addressLookup            Boolean @default(true) @map("address_lookup")
  remoteCheck              Boolean @default(true) @map("remote_check")
  propertyRegisterSearch   Boolean @default(true) @map("property_register_search")
  nfiAddress               Boolean @default(true) @map("nfi_address")
  nfiAmberhill             Boolean @default(true) @map("nfi_amberhill")
  emailRisk                Boolean @default(true) @map("email_risk")
  otpEmail                 Boolean @default(true) @map("otp_email")
  otpSms                   Boolean @default(true) @map("otp_sms")
  phoneMatch               Boolean @default(true) @map("phone_match")
  phoneNumberValidation    Boolean @default(true) @map("phone_number_validation")
  bankaccount              Boolean @default(true)
  creditActivity           Boolean @default(true) @map("credit_activity")
  // config.* sub-object.
  configFullEr     Boolean  @default(false) @map("config_full_er")
  configAgeMin     Int?     @map("config_age_min")
  configAgeMax     Int?     @map("config_age_max")
  configNfiAddress Boolean  @default(false) @map("config_nfi_address")
  // bridger_* fields — opaque, no attributed behavior (see spec.md).
  bridgerClientId         String?  @map("bridger_client_id")
  bridgerClientSecret     String?  @map("bridger_client_secret")
  bridgerPredefinedSearch String?  @map("bridger_predefined_search")
  bridgerUserId           String?  @map("bridger_user_id")
  bridgerCustomerToggle   Boolean  @default(false) @map("bridger_customer_toggle")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("user_options")
}

model ActivityLog {
  id             String   @id @default(uuid())
  clientId       String   @map("client_id")
  client         Client   @relation(fields: [clientId], references: [id])
  pathIdentifier String?  @map("path_identifier")
  method         String
  path           String
  ip             String?
  status         Int
  application    String?
  level          String?
  channel        String?
  serverName     String?  @map("server_name")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}
